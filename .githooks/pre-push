#!/usr/bin/env bash
# Local validation before pushing. Main and release tags run the full local CI
# check; ordinary branches run only the packages affected since the remote tip.
# Force the full check with QRYPT_FULL_PUSH_CHECK=1. Skip with:
# git push --no-verify or QRYPT_SKIP_HOOKS=1.
set -euo pipefail
[ -n "${QRYPT_SKIP_HOOKS:-}" ] && exit 0

# $1 = remote name, $2 = remote URL; the pushed refs arrive on stdin as
# "<local ref> <local oid> <remote ref> <remote oid>" lines.
full_check=false
push_base=""
while read -r _local_ref _local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/main|refs/tags/v*)
      full_check=true
      ;;
  esac
  if [ -z "$push_base" ] && [ "$remote_oid" != "0000000000000000000000000000000000000000" ]; then
    push_base="$remote_oid"
  fi
done

if [ "${QRYPT_FULL_PUSH_CHECK:-0}" = "1" ]; then
  full_check=true
fi

if [ "$full_check" = true ]; then
  cd "$(git rev-parse --show-toplevel)"
  scripts/ci/check-all.sh
elif [ -n "$push_base" ]; then
  cd "$(git rev-parse --show-toplevel)"
  QRYPT_DIFF_BASE="$push_base" scripts/ci/test-layers.sh changed
else
  echo "pre-push: new remote ref has no base commit; skipping local package check" >&2
fi
