#!/usr/bin/env bash
# Fast local gate before every commit: format, vet, affected suite.
# The suite is narrowed to the packages the staged diff can reach, so a
# localized commit costs seconds instead of the ~22s a full module run takes.
# pre-push runs scripts/ci-check.sh over everything either way, which is where
# the narrowing is paid for; run `scripts/test-layers.sh fast` to force the
# whole module here too. Skip with: git commit --no-verify
set -euo pipefail
[ -n "${QRYPT_SKIP_HOOKS:-}" ] && exit 0
cd "$(git rev-parse --show-toplevel)"

echo "== pre-commit: gofmt =="
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "gofmt needed on:" >&2
  echo "$unformatted" >&2
  exit 1
fi

echo "== pre-commit: go vet =="
go vet ./...

echo "== pre-commit: affected suite =="
scripts/test-layers.sh changed